#!/bin/bash

stop_file=/tmp/retrogrzmot-led-stop
lock=(/usr/bin/flock -w 12 /tmp/retrogrzmot-led.lock)
case "$1" in
    start|steady) ;;
    get|animate) lock=() ;;
    set|reset) lock=(/usr/bin/flock -w 1 /tmp/retrogrzmot-led.lock) ;;
    stop) : > "$stop_file" || exit 1 ;;
    *) exit 2 ;;
esac

"${lock[@]}" /usr/bin/python3 - "$stop_file" "$0" "$@" <<'PY'
import atexit
import fcntl
import json
import os
import random
import subprocess
import sys
import tempfile
import time
import uuid
from pathlib import Path
from contextlib import contextmanager

stopping = Path(sys.argv[1])
service_file = sys.argv[2]
action, *args = sys.argv[3:]
animation = stopping.with_name('retrogrzmot-led-animation')
hardware_lock = stopping.with_name('retrogrzmot-led-hardware.lock')
settings_file = Path('/userdata/system/configs/retrogrzmot-led.json')
zones = ('logo', 'base')
palette = {
    'amber': (255, 128, 32),
    'warm-white': (255, 210, 155),
    'red': (255, 0, 0),
    'green': (0, 255, 0),
    'blue': (0, 105, 255),
    'cyan': (0, 255, 255),
    'purple': (175, 45, 255),
}
factory = {'enabled': True, 'color': 'amber', 'effect': 'steady', 'brightness': 30}
effects = ('steady', 'rider', 'flash')
pixel_count = 43
logo_pixels = 5
visible_pixels = 40
steady_level = 3


def read_settings():
    try:
        data = json.loads(settings_file.read_text(encoding='utf-8'))
    except (FileNotFoundError, json.JSONDecodeError, UnicodeDecodeError):
        data = {}
    if not isinstance(data, dict):
        data = {}

    settings = {}
    for zone in zones:
        config = data.get(zone)
        if not isinstance(config, dict):
            config = {}
        value = factory.copy()
        if type(config.get('enabled')) is bool:
            value['enabled'] = config['enabled']
        color = config.get('color')
        if isinstance(color, str) and color in palette:
            value['color'] = color
        if config.get('effect') in effects:
            value['effect'] = config['effect']
        brightness = config.get('brightness')
        if type(brightness) is int and 0 <= brightness <= 100:
            value['brightness'] = brightness
        if value['brightness'] == 0:
            value['enabled'] = False
        settings[zone] = value
    return settings


def save_settings(settings):
    settings_file.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', encoding='utf-8',
                                     dir=settings_file.parent, delete=False) as output:
        temp = Path(output.name)
        try:
            json.dump(settings, output, indent=2)
            output.write('\n')
            output.flush()
            os.fsync(output.fileno())
            output.close()
            temp.replace(settings_file)
        finally:
            temp.unlink(missing_ok=True)


def changed_settings(settings):
    if not args or args[0] not in zones:
        sys.exit('Expected zone: logo or base')
    zone = args[0]
    updated = settings.copy()
    updated[zone] = settings[zone].copy()
    if action == 'reset' and len(args) == 1:
        updated[zone] = factory.copy()
    elif action == 'set' and len(args) == 3:
        field, value = args[1:]
        if field == 'enabled' and value in ('on', 'off'):
            updated[zone][field] = value == 'on'
            if value == 'on' and updated[zone]['brightness'] == 0:
                updated[zone]['brightness'] = factory['brightness']
        elif field == 'color' and value in palette:
            updated[zone][field] = value
        elif field == 'effect' and value in effects:
            updated[zone][field] = value
        elif field == 'brightness' and value.isascii() and value.isdecimal() and len(value) <= 3 and int(value) <= 100:
            brightness = int(value)
            if brightness == 0 or updated[zone]['brightness'] == 0:
                updated[zone]['enabled'] = brightness > 0
            updated[zone][field] = brightness
        else:
            sys.exit('Invalid lighting setting')
    else:
        sys.exit('Invalid lighting command')
    return updated


settings = {} if action == 'stop' else read_settings()
if action == 'get':
    if not args or args[0] not in zones or args[1:] not in ([], ['--brightness']):
        sys.exit('Expected zone: logo or base')
    config = settings[args[0]]
    values = ['on' if config['enabled'] else 'off', config['color'], config['effect']]
    if args[1:]:
        values.append(config['brightness'])
    print(*values)
    sys.exit()

from rpi_ws281x import Color, PixelStrip, ws


@contextmanager
def open_strip():
    strip = PixelStrip(pixel_count, 21, 800000, 10, False, 255, 0, ws.WS2811_STRIP_GRB)
    try:
        strip.begin()
        yield strip
    finally:
        # The driver normally releases DMA at process exit. Release it while locked.
        atexit.unregister(strip._cleanup)
        strip._cleanup()


def pixel(config, percent, limit=255):
    if not config['enabled']:
        return 0
    scale = min(limit, round(255 * percent / 100)) + 1
    return Color(*(channel * scale // 256 for channel in palette[config['color']]))


def steady_pixel(config):
    percent = config['brightness'] / 10
    if config['effect'] == 'flash' and percent:
        percent = steady_level
    return pixel(config, percent, limit=25)


def show(strip, first, rest, delayed=None, delayed_color=0):
    for index in range(pixel_count):
        color = first if index < logo_pixels else rest
        if index == delayed:
            color = delayed_color
        strip.setPixelColor(index, color)
    strip.show()


def animation_active(config):
    return config['effect'] != 'steady' and config['enabled'] and config['brightness'] > 0


def rider_pixels(config, length, tick):
    period = 2 * (length - 1)
    peak = min(25, round(255 * config['brightness'] / 1000))
    values = [0] * length
    for delay, intensity in enumerate((1, .60, .32, .15)):
        phase = (tick - delay) % period
        index = min(phase, period - phase)
        values[index] = max(values[index], round(peak * intensity))
    return [Color(red, 0, 0) for red in values]


def flash_pixels(config, length, center):
    colors = [steady_pixel(config)] * length
    if center is not None:
        for index in range(max(0, center - 2), min(length, center + 3)):
            percent = 10 - 3 * abs(index - center)
            colors[index] = pixel(config, percent, limit=25)
    return colors


def flash_center(timers, zone, now, length):
    if timers is None:
        return None
    if zone not in timers:
        timers[zone] = now + random.uniform(3, 6), None
    deadline, center = timers[zone]
    if now >= deadline:
        if center is None:
            center = random.randrange(length)
            timers[zone] = now + .15, center
        else:
            center = None
            timers[zone] = now + random.uniform(3, 6), None
    return center


def render(strip, settings, timers=None):
    if stopping.exists():
        show(strip, 0, 0)
        return
    now = time.monotonic()
    for zone, first, last, speed in (
        ('logo', 0, logo_pixels, .12), ('base', logo_pixels, visible_pixels, .06),
    ):
        config = settings[zone]
        length = last - first
        animated = animation_active(config)
        if animated:
            if config['effect'] == 'rider':
                colors = rider_pixels(config, length, int(now / speed))
            else:
                colors = flash_pixels(config, length, flash_center(timers, zone, now, length))
        else:
            colors = [steady_pixel(config)] * length
        if zone == 'base':
            colors.extend([0 if animated else steady_pixel(config)] * (pixel_count - last))
        for index, color in enumerate(colors, first):
            strip.setPixelColor(index, color)
    strip.show()


def start_animation(settings):
    if stopping.exists() or not any(animation_active(config) for config in settings.values()):
        return
    generation = uuid.uuid4().hex
    animation.write_text(generation, encoding='ascii')
    subprocess.Popen([service_file, 'animate', generation], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def animate(generation):
    def active():
        try:
            return not stopping.exists() and animation.read_text(encoding='ascii') == generation
        except FileNotFoundError:
            return False

    if not active():
        return
    timers = {}
    with open_strip() as strip:
        while active():
            render(strip, settings, timers)
            time.sleep(.03)


def startup(strip):
    # The physical strip was shortened to approximately 40 LEDs.
    delayed = random.randrange(logo_pixels, visible_pixels)
    first = [
        (0.08, 10), (0.17, 0), (0.29, 6), (0.41, 0),
        (1.12, 9), (1.25, 1), (2.23, 7), (2.35, 0), (2.51, 4), (2.66, 1),
        (4.30, 10), (4.42, 0), (4.76, 12), (5.00, steady_level),
    ]
    rest = [
        (0.32, 5), (0.49, 0), (0.66, 9), (0.75, 0),
        (1.85, 6), (1.98, 0), (3.20, 8), (3.32, 1),
        (4.10, 7), (4.24, 0), (5.65, 9), (5.77, 0), (5.96, 6), (6.09, 1),
        (7.25, 10), (7.38, 0), (7.77, 12), (8.02, steady_level),
    ]
    catch_up = [
        (8.50, 8), (8.56, 0), (8.67, 5), (8.75, 0),
        (9.00, 9), (9.09, 0), (9.28, 6), (9.36, 0),
        (9.78, 8), (9.85, 0), (10.00, steady_level),
    ]
    events = sorted((at, zone, level)
                    for zone, timeline in enumerate((first, rest, catch_up))
                    for at, level in timeline)
    colors = [
        steady_pixel(settings[zone]) if settings[zone]['effect'] == 'flash' else 0
        for zone in ('logo', 'base', 'base')
    ]
    show(strip, *colors[:2])
    started = time.monotonic()
    try:
        for at, zone, level in events:
            remaining = started + at - time.monotonic()
            while remaining > 0 and not stopping.exists():
                time.sleep(min(remaining, 0.05))
                remaining = started + at - time.monotonic()
            if stopping.exists():
                break
            config = settings[zones[min(zone, 1)]]
            if config['effect'] == 'flash' or level == steady_level:
                colors[zone] = steady_pixel(config)
            else:
                colors[zone] = pixel(config, level) if config['brightness'] else 0
            show(strip, colors[0], colors[1], delayed, colors[2])
    finally:
        render(strip, settings)


def apply_command():
    if action in ('set', 'reset'):
        updated = changed_settings(settings)
        if stopping.exists():
            sys.exit('Lighting service is stopped')
    else:
        if args:
            sys.exit('Unexpected arguments')
        updated = settings
        if action in ('start', 'steady'):
            stopping.unlink(missing_ok=True)

    animation.unlink(missing_ok=True)
    with hardware_lock.open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with open_strip() as strip:
            if action == 'start':
                startup(strip)
            elif action == 'stop':
                show(strip, 0, 0)
            else:
                render(strip, updated)
                try:
                    if updated != settings:
                        save_settings(updated)
                except OSError:
                    render(strip, settings)
                    start_animation(settings)
                    raise
            if action != 'stop':
                start_animation(updated)
    print('RETROGRZMOT LED:', action)


if action == 'animate':
    if len(args) != 1:
        sys.exit('Missing animation generation')
    with hardware_lock.open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        animate(args[0])
else:
    apply_command()
PY
